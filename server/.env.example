PORT=5000
CLIENT_URL=http://localhost:5173
USE_MYSQL=true
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=kesariya_garba
MYSQL_USER=root
MYSQL_PASSWORD=root

# Razorpay Test Mode credentials. Keep the secret out of Git.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# Optional in local development; required for production Turnstile verification.
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Admin authentication. Required when USE_MYSQL=true.
ADMIN_EMAIL=admin@example.com
# Prefer a scrypt hash in production: scrypt:<salt>:<64-byte-hex-hash>
ADMIN_PASSWORD_HASH=scrypt:replace-with-random-salt:replace-with-64-byte-hex-hash
# Plain ADMIN_PASSWORD is supported for local/bootstrap use; do not commit real secrets.
ADMIN_PASSWORD=replace-with-a-strong-password
# Use a long random value; it signs 8-hour admin sessions.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
