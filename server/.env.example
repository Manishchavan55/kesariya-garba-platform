PORT=5000
CLIENT_URL=http://localhost:5173
USE_MYSQL=false
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=kesariya_garba
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# Required only when USE_MYSQL=true and real Razorpay payments are enabled
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Optional in demo mode; required for production Turnstile verification
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Production admin bootstrap values. Keep these only in the server environment; never commit them.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
